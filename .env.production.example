# Segredos de produção. Copie para .env e NUNCA versione.
APP_USER=pulso
APP_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
# Assina o cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Para Docker Compose / VPS. Railway/Render/Fly definem PORT e HOST no painel.
HOST=0.0.0.0
PORT=4175
PULSO_DATA_DIR=/data
TRUST_PROXY=1

# Banco gratuito Turso (persistência 24/7)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opcional: geração de questões por IA
# VENICE_API_KEY=
# VENICE_MODEL=deepseek-v4-1-flash-uncensored
